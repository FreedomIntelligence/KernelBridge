new file mode 100644
index 0000000..54c0558
--- /dev/null
+++ b/examples/cann/make_tasks.py
@@ -0,0 +1,96 @@
+"""Regenerate the two CANN task examples from case.json; no model or device calls."""
+from pathlib import Path
+import json
+
+ROOT = Path(__file__).resolve().parent
+FIELDS = ['project_json_src', 'host_tiling_src', 'host_operator_src', 'kernel_src', 'python_bind_src', 'model_src']
+
+
+def build_task(case, baseline, objective, mode="generate"):
+    if mode not in ("generate", "optimize"):
+        raise ValueError("mode must be generate or optimize")
+    vector = case['kind'] == 'vector_add'
+    dtype = case['dtype']
+    if case['kind'] not in ('vector_add', 'matmul') or dtype not in ('float16', 'float32'):
+        raise ValueError('examples support vector_add/matmul and float16/float32')
+    shapes = [case['shape'], case['shape']] if vector else [[case['m'], case['k']], [case['k'], case['n']]]
+    output_shape = case['shape'] if vector else [case['m'], case['n']]
+    if len(case['seeds']) != 5 or any(type(x) is not int for x in case['seeds']):
+        raise ValueError('the default six-source evaluator performs exactly five correctness trials')
+    if any(type(x) is not int or x < 1 for shape in shapes for x in shape):
+        raise ValueError('these introductory examples require positive dimensions')
+    if case['distribution'] != 'standard_normal':
+        raise ValueError('implement the requested distribution before changing this field')
+    expression = 'a + b' if vector else 'torch.matmul(a.detach().cpu().float(), b.detach().cpu().float()).to(device=a.device, dtype=a.dtype)'
+    reference = f'''"""Frozen reference and input generator; generated from case.json."""
+import torch
+
+SHAPES = {shapes!r}
+SEEDS = {case['seeds']!r}
+DTYPE = torch.{dtype}
+_trial = 0
+
+class Model(torch.nn.Module):
+    def forward(self, a, b):
+        return {expression}
+
+def get_inputs():
+    global _trial
+    generator = torch.Generator(device='cpu').manual_seed(SEEDS[_trial % len(SEEDS)])
+    _trial += 1
+    return [torch.randn(shape, generator=generator, dtype=DTYPE) for shape in SHAPES]
+
+def get_init_inputs():
+    return []
+'''
+    name = 'Vector 向量加法' if vector else 'Cube 矩阵乘法'
+    semantics = '逐元素计算 c = a + b，两个输入形状相同，不广播。' if vector else f'计算 C[M,N] = A[M,K] @ B[K,N]，不转置、无 bias、无 batch；以 FP32 累加，最终转换为 {dtype} 输出。'
+    class_name = ''.join(part.capitalize() for part in case['native_operator'].split('_')) + 'Custom'
+    entry = case['native_operator'] + '_custom'
+    goal = objective.strip() + '\n\n' + (f'使用 Ascend C 实现{name}。{semantics} '
+        f'输入形状为 {shapes}，连续 ND 布局，dtype={dtype}；输出形状 {output_shape}，dtype={dtype}。'
+        f'目标为 {case["soc"]}。先读取 reference/case.json 与 reference/reference.py，'
+        '再用 Pi 文件工具在 solution.py 中生成完整候选。'
+        f'solution.py 须定义六个非空字符串：{", ".join(FIELDS)}。'
+        f'project_json_src 的算子名为 {class_name}，kernel 入口为 {entry}，'
+        'model_src 定义 torch.nn.Module 子类 ModelNew，其 forward(a,b) 返回单个 Tensor。'
+        + ('使用 Vector 计算单元实现。' if vector else '使用 Cube/Matmul 计算路径实现，不能用标量循环模拟矩阵乘法。')
+        + '禁止调用 torch 加法/matmul 代替候选内核，禁止修改输入、参考文件、测试数据或评测器。'
+        '每次有意义的修改后调用配置的业务评测工具，依据原始编译错误、正确性和性能结果修复；'
+        f'必须通过 case.json 中全部五个随机种子，浮点比较 atol={case["atol"]}, rtol={case["rtol"]}。'
+        '只有原始评测凭据能够证明正确性与性能。没有成对复测时不要宣称加速；结束时留下有通过凭据的候选。')
+    goal += (' Read reference/native-template.py for a verified six-source example of this operator on CANN 9.1 / Ascend910_9382; adapt names, shapes and tiling for the declared task. Preserve the demonstrated tiling serialization, workspace and synchronization contracts. Use evaluate(candidate="solution.py") and read original receipts. Do not finish with any compile or correctness failure. This generation example requires one verified candidate: after all five input seeds pass, read its original receipt and finish. Run longer performance search as a separate goal.')
+    contract = {'operator': case['kind'], 'native_operator':case['native_operator'],
+        'target':{'soc':case['soc'], 'device':case['device']},
+        'inputs':[{'name':name,'shape':shape,'dtype':dtype,'layout':'contiguous ND'} for name,shape in zip(('a','b'),shapes)],
+        'output':{'shape':output_shape,'dtype':dtype,'layout':'contiguous ND'},
+        'semantics':semantics, 'input_mutation_allowed':False,
+        'test_data':{'distribution':case['distribution'],'seeds':case['seeds'], 'generator':'reference/reference.py:get_inputs', 'correctness_trials':5},
+        'correctness':{'atol':case['atol'],'rtol':case['rtol'],'finite_inputs':True},
+        'candidate':{'path':'solution.py','format':'six_source','required_fields':FIELDS},
+        'performance':{'timer':'npu_event','device_stream':'explicit target device','warmup':3,'samples':100,
+            'comparison':'same-device interleaved paired measurements; compile and input preparation excluded'}}
+    task={'id':case['task_id'],'scope':'cann-operator-generation','goal':goal,'contract':contract,
+        'seed_files':{'solution.py':baseline if mode == 'optimize' else '"""Implement the six-source Ascend C candidate specified by this task."""\n',
+            'reference/case.json':json.dumps(case,ensure_ascii=False,indent=2)+'\n','reference/reference.py':reference,
+            'reference/native-template.py':baseline}}
+    request={'candidate':'./workspace/solution.py','reference':'./reference.py','workspace':'./new-evaluation-job',
+        'operator':case['native_operator'],'soc':case['soc'],'device':case['device'],'fast':False,'timeout':600,
+        'atol':case['atol'],'rtol':case['rtol']}
+    if mode == 'optimize':
+        task['goal'] = objective.strip() + '\nOptimize the provided native baseline. Read the frozen case and reference, keep all tests correct, use Pi tools to edit solution.py, then call run_experiment(hypothesis, expected_delta, cites=[]). Read the restored source after rejection. Only original paired measurements and independent confirmation can establish improvement. Preserve the accepted source when the budget ends.'
+    return task, reference, request
+
+
+def generate(directory):
+    from task_bundle import load_bundle
+    task, reference, request, _ = load_bundle(directory / 'task.json')
+    for name, value in [('task.compiled.json',task), ('evaluation-request.example.json',request)]:
+        (directory/name).write_text(json.dumps(value,ensure_ascii=False,indent=2)+'\n')
+    (directory/'reference.py').write_text(reference)
+
+
+if __name__ == '__main__':
+    for name in ('vector-add','cube-matmul'):
+        generate(ROOT/name)
+        print(ROOT/name/'task.json')
diff --git a/examples/cann/matmul-template.py b/examples/cann/matmul-template.py
new file mode 100644
index 0000000..94498d4
--- /dev/null
+++ b/examples/cann/matmul-template.py
@@ -0,0 +1,176 @@
+"""Six-source candidate: Cube matmul C = A @ B (no transpose, no bias), FP32 accum, FP16 out."""
+import json
+
+project_json_src = json.dumps([{
+    'op': 'MatmulCustom', 'language': 'cpp',
+    'input_desc': [
+        {'name': 'a', 'param_type': 'required', 'format': ['ND'], 'type': ['float16']},
+        {'name': 'b', 'param_type': 'required', 'format': ['ND'], 'type': ['float16']},
+    ],
+    'output_desc': [{'name': 'c', 'param_type': 'required', 'format': ['ND'], 'type': ['float16']}],
+}])
+
+host_tiling_src = r'''
+#ifndef MATMUL_CUSTOM_TILING_H
+#define MATMUL_CUSTOM_TILING_H
+#include "register/tilingdata_base.h"
+#include "tiling/tiling_api.h"
+
+namespace optiling {
+BEGIN_TILING_DATA_DEF(MatmulCustomTilingData)
+TILING_DATA_FIELD_DEF_STRUCT(TCubeTiling, cubeTiling);
+END_TILING_DATA_DEF;
+
+REGISTER_TILING_DATA_CLASS(MatmulCustom, MatmulCustomTilingData)
+}  // namespace optiling
+
+// Host-side mirror of the registered tiling struct for the kernel-side header copy.
+struct MatmulCustomTilingData { TCubeTiling cubeTiling; };
+#endif
+'''
+
+host_operator_src = r'''
+#include <cstdint>
+#include "tiling/platform/platform_ascendc.h"
+#include "tiling/tiling_api.h"
+#include "../op_kernel/matmul_custom_tiling.h"
+#include "register/op_def_registry.h"
+
+namespace optiling {
+static ge::graphStatus TilingFunc(gert::TilingContext* c) {
+  MatmulCustomTilingData tilingData;
+  optiling::TCubeTiling& cubeTiling = tilingData.cubeTiling;
+
+  const gert::StorageShape* aShape = c->GetInputShape(0);
+  const gert::StorageShape* bShape = c->GetInputShape(1);
+  int32_t M = static_cast<int32_t>(aShape->GetStorageShape().GetDim(0));
+  int32_t K = static_cast<int32_t>(aShape->GetStorageShape().GetDim(1));
+  int32_t N = static_cast<int32_t>(bShape->GetStorageShape().GetDim(1));
+
+  platform_ascendc::PlatformAscendC platform(c->GetPlatformInfo());
+  matmul_tiling::MatmulApiTiling mmTiling(platform);
+  mmTiling.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
+                    matmul_tiling::DataType::DT_FLOAT16, false);
+  mmTiling.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
+                    matmul_tiling::DataType::DT_FLOAT16, false);
+  mmTiling.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
+                    matmul_tiling::DataType::DT_FLOAT16);
+  mmTiling.SetBias(false);
+  mmTiling.SetShape(M, N, K);
+  mmTiling.SetOrgShape(M, N, K);
+  mmTiling.SetFixSplit(M, N, K);
+
+  if (mmTiling.GetTiling(cubeTiling) == -1) {
+    return ge::GRAPH_FAILED;
+  }
+
+  cubeTiling.set_usedCoreNum(1);
+  cubeTiling.set_singleCoreM(M);
+  cubeTiling.set_singleCoreN(N);
+  cubeTiling.set_singleCoreK(K);
+
+  tilingData.SaveToBuffer(c->GetRawTilingData()->GetData(),
+                          c->GetRawTilingData()->GetCapacity());
+  c->GetRawTilingData()->SetDataSize(tilingData.GetDataSize());
+
+  c->SetBlockDim(1);
+  c->GetWorkspaceSizes(1)[0] =
+      static_cast<size_t>(platform.GetLibApiWorkSpaceSize());
+  return ge::GRAPH_SUCCESS;
+}
+}  // namespace optiling
+
+namespace ge {
+static ge::graphStatus InferShape(gert::InferShapeContext* c) {
+  auto aShape = *c->GetInputShape(0);
+  auto bShape = *c->GetInputShape(1);
+  gert::Shape* outShape = c->GetOutputShape(0);
+  outShape->SetDimNum(2);
+  outShape->SetDim(0, aShape.GetDim(0));
+  outShape->SetDim(1, bShape.GetDim(1));
+  return GRAPH_SUCCESS;
+}
+static ge::graphStatus InferDataType(gert::InferDataTypeContext* c) {
+  c->SetOutputDataType(0, c->GetInputDataType(0));
+  return GRAPH_SUCCESS;
+}
+}  // namespace ge
+
+namespace ops {
+class MatmulCustom : public OpDef {
+ public:
+  explicit MatmulCustom(const char* name) : OpDef(name) {
+    this->Input("a").ParamType(REQUIRED).DataType({ge::DT_FLOAT16}).Format({ge::FORMAT_ND}).UnknownShapeFormat({ge::FORMAT_ND});
+    this->Input("b").ParamType(REQUIRED).DataType({ge::DT_FLOAT16}).Format({ge::FORMAT_ND}).UnknownShapeFormat({ge::FORMAT_ND});
+    this->Output("c").ParamType(REQUIRED).DataType({ge::DT_FLOAT16}).Format({ge::FORMAT_ND}).UnknownShapeFormat({ge::FORMAT_ND});
+    this->SetInferShape(ge::InferShape).SetInferDataType(ge::InferDataType);
+    this->AICore().SetTiling(optiling::TilingFunc);
+    this->AICore().AddConfig("ascend910_93");
+  }
+};
+OP_ADD(MatmulCustom);
+}  // namespace ops
+'''
+
+kernel_src = r'''
+#define ASCENDC_CUBE_ONLY
+#include "kernel_operator.h"
+#include "kernel_tiling/kernel_tiling.h"
+#include "lib/matmul_intf.h"
+
+using namespace AscendC;
+
+extern "C" __global__ __aicore__ void matmul_custom(GM_ADDR a, GM_ADDR b, GM_ADDR c,
+                                                    GM_ADDR workspace, GM_ADDR tiling) {
+  GET_TILING_DATA(tilingData, tiling);
+  const TCubeTiling* cubeTiling = &tilingData.cubeTiling;
+
+  if (GetSysWorkSpacePtr() == nullptr) {
+    return;
+  }
+
+  using A_T = MatmulType<TPosition::GM, CubeFormat::ND, half, false>;
+  using B_T = MatmulType<TPosition::GM, CubeFormat::ND, half, false>;
+  using C_T = MatmulType<TPosition::GM, CubeFormat::ND, half, false>;
+  using BIAS_T = MatmulType<TPosition::GM, CubeFormat::ND, float, false>;
+
+  TPipe pipe;
+  Matmul<A_T, B_T, C_T, BIAS_T> mm;
+  REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, const_cast<TCubeTiling*>(cubeTiling));
+
+  GlobalTensor<half> aGm;
+  GlobalTensor<half> bGm;
+  GlobalTensor<half> cGm;
+  aGm.SetGlobalBuffer((__gm__ half*)a);
+  bGm.SetGlobalBuffer((__gm__ half*)b);
+  cGm.SetGlobalBuffer((__gm__ half*)c);
+
+  mm.SetTensorA(aGm, false);
+  mm.SetTensorB(bGm, false);
+  mm.IterateAll(cGm);
+  mm.End();
+}
+'''
+
+python_bind_src = r'''
+#include <torch/extension.h>
+#include "pytorch_npu_helper.hpp"
+
+at::Tensor matmul_custom(const at::Tensor& a, const at::Tensor& b) {
+  auto c = at::empty({a.size(0), b.size(1)}, a.options());
+  EXEC_NPU_CMD(aclnnMatmulCustom, a, b, c);
+  return c;
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) { m.def("matmul_custom", &matmul_custom); }
+'''
+
+model_src = '''
+import torch
+import custom_ops_lib
+
+
+class ModelNew(torch.nn.Module):
+    def forward(self, a, b):
+        return custom_ops_lib.matmul_custom(a, b)
+'''
