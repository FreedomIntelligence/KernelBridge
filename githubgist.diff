+{
+  "id": "cannbench-sigmoid-native-optimization",
+  "scope": "native-cannbench-optimization",
+  "goal": "Optimize the provided correct native Ascend C Sigmoid on Ascend910_9382 / CANN 9.1. This is an optimization warm start, not a from-scratch generation claim. The hand-authored one-core seed has passed all 20 archived CANNBench Season 1 cases using the original data generator, full-output MERE/MARE checks, and input preservation. Read reference/cases.yaml and the seed. Keep all 20 cases and all FP16/BF16/FP32 types correct, including NaN/Inf and irregular lengths. Write real improvements to solution.py with Pi tools and call run_experiment with hypothesis, expected_delta (log speedup), and cites:[]; do not invent knowledge IDs. Explore multicore partitioning, tile sizes and pipeline optimization. The seed intentionally uses one core; allocate work across actual vector cores and align boundaries to 32 bytes. Preserve its verified host tiling, REGISTER_TILING_DEFAULT and DTYPE_X selection until you have measured an alternative. A standalone FP32 Reciprocal was measured with relative error about 0.0026 on this device and failed accuracy; the seed's tensor Div passes all 20 cases. Do not replace Div by approximate Reciprocal unless you implement and validate accurate refinement with correct Inf/NaN behavior. No Torch fallback, test modification, hardcoded outputs or child delegation. Make one small measurable change at a time; start by changing only the host core count and keep the verified partition and math code. run_experiment captures the current file; a hypothesis alone changes nothing. Use edit or write before submitting. Run the full 40 parent model turns, using the budget for meaningful native candidate measurements and repairs, even if an early change helps. Independent confirmation controls retention. Finish with the best retained correct source and source-bound receipts. A speedup against this deliberately conservative native seed is distinct from performance against torch.sigmoid; do not claim vendor superiority without a separate matched comparison.",
+  "seed_files": {
+    "solution.py": "\"\"\"Conservative one-core native seed for a separately labelled optimization trial.\n\nHand-authored from the verified Vector queue pattern. It is not a model-generated\nsolution or a performance claim; the full CANNBench suite must qualify it first.\n\"\"\"\nimport json\n\nproject_json_src = json.dumps([{\n    'op': 'SigmoidCustom', 'language': 'cpp',\n    'input_desc': [{'name': 'x', 'param_type': 'required', 'format': ['ND'],\n                    'type': ['float16', 'float', 'bfloat16']}],\n    'output_desc': [{'name': 'y', 'param_type': 'required', 'format': ['ND'],\n                     'type': ['float16', 'float', 'bfloat16']}],\n}])\n\nhost_tiling_src = r'''\n#ifndef SIGMOID_CUSTOM_TILING_H\n#define SIGMOID_CUSTOM_TILING_H\n#include <cstdint>\nstruct SigmoidCustomTilingData { uint32_t total; uint32_t perCore; uint32_t tile; };\n#endif\n'''\n\nhost_operator_src = r'''\n#include \"../op_kernel/sigmoid_custom_tiling.h\"\n#include \"register/op_def_registry.h\"\nnamespace optiling {\nstatic ge::graphStatus TilingFunc(gert::TilingContext* c) {\n    auto* t = c->GetTilingData<SigmoidCustomTilingData>();\n    t->total = static_cast<uint32_t>(c->GetInputShape(0)->GetStorageShape().GetShapeSize());\n    constexpr uint32_t cores = 1;\n    t->perCore = ((t->total + cores - 1) / cores + 15) / 16 * 16;\n    t->tile = 2048;\n    c->SetBlockDim(cores);\n    c->GetWorkspaceSizes(1)[0] = 0;\n    return ge::GRAPH_SUCCESS;\n}\n}\nnamespace ge {\nstatic ge::graphStatus InferShape(gert::InferShapeContext* c) {\n    *c->GetOutputShape(0) = *c->GetInputShape(0); return GRAPH_SUCCESS;\n}\nstatic ge::graphStatus InferDataType(gert::InferDataTypeContext* c) {\n    c->SetOutputDataType(0, c->GetInputDataType(0)); return GRAPH_SUCCESS;\n}\n}\nnamespace ops {\nclass SigmoidCustom : public OpDef {\npublic:\n    explicit SigmoidCustom(const char* name) : OpDef(name) {\n        this->Input(\"x\").ParamType(REQUIRED).DataType({ge::DT_FLOAT16,ge::DT_FLOAT,ge::DT_BF16})\n            .Format({ge::FORMAT_ND,ge::FORMAT_ND,ge::FORMAT_ND})\n            .UnknownShapeFormat({ge::FORMAT_ND,ge::FORMAT_ND,ge::FORMAT_ND});\n        this->Output(\"y\").ParamType(REQUIRED).DataType({ge::DT_FLOAT16,ge::DT_FLOAT,ge::DT_BF16})\n            .Format({ge::FORMAT_ND,ge::FORMAT_ND,ge::FORMAT_ND})\n            .UnknownShapeFormat({ge::FORMAT_ND,ge::FORMAT_ND,ge::FORMAT_ND});\n        this->SetInferShape(ge::InferShape).SetInferDataType(ge::InferDataType);\n        this->AICore().SetTiling(optiling::TilingFunc).AddConfig(\"ascend910_93\");\n    }\n};\nOP_ADD(SigmoidCustom);\n}\n'''\n\nkernel_src = r'''\n#include \"kernel_operator.h\"\n#include \"sigmoid_custom_tiling.h\"\nusing namespace AscendC;\ntemplate<class T> class SigmoidKernel {\npublic:\n    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, const SigmoidCustomTilingData& t) {\n        uint32_t base = GetBlockIdx() * t.perCore;\n        count = base < t.total ? (t.perCore < t.total - base ? t.perCore : t.total - base) : 0;\n        tile = t.tile;\n        xGm.SetGlobalBuffer((__gm__ T*)x + base, count);\n        yGm.SetGlobalBuffer((__gm__ T*)y + base, count);\n        pipe.InitBuffer(input, 1, tile * sizeof(T));\n        pipe.InitBuffer(output, 1, tile * sizeof(T));\n        pipe.InitBuffer(scratch, tile * sizeof(float));\n        pipe.InitBuffer(onesBuffer, tile * sizeof(float));\n    }\n    __aicore__ inline void Process() {\n        for (uint32_t off = 0; off < count; off += tile) {\n            uint32_t n = tile < count - off ? tile : count - off;\n            LocalTensor<T> x = input.AllocTensor<T>();\n            DataCopyExtParams cp{1, static_cast<uint32_t>(n * sizeof(T)), 0, 0, 0};\n            DataCopyPadExtParams<T> pad{false, 0, 0, 0};\n            DataCopyPad(x, xGm[off], cp, pad);\n            input.EnQue(x); x = input.DeQue<T>();\n            LocalTensor<float> f = scratch.Get<float>();\n            if constexpr (sizeof(T) == sizeof(float)) {\n                Muls(f, x.template ReinterpretCast<float>(), -1.0f, n);\n            } else {\n                Cast(f, x, RoundMode::CAST_NONE, n);\n                PipeBarrier<PIPE_V>(); Muls(f, f, -1.0f, n);\n            }\n            PipeBarrier<PIPE_V>(); Exp(f, f, n);\n            PipeBarrier<PIPE_V>(); Adds(f, f, 1.0f, n);\n            LocalTensor<float> ones = onesBuffer.Get<float>();\n            PipeBarrier<PIPE_V>(); Duplicate(ones, 1.0f, n);\n            PipeBarrier<PIPE_V>(); Div(f, ones, f, n);\n            PipeBarrier<PIPE_V>();\n            LocalTensor<T> y = output.AllocTensor<T>();\n            if constexpr (sizeof(T) == sizeof(float)) {\n                Muls(y.template ReinterpretCast<float>(), f, 1.0f, n);\n            } else { Cast(y, f, RoundMode::CAST_RINT, n); }\n            output.EnQue(y); y = output.DeQue<T>();\n            DataCopyPad(yGm[off], y, cp);\n            input.FreeTensor(x); output.FreeTensor(y);\n        }\n    }\nprivate:\n    TPipe pipe;\n    TQue<QuePosition::VECIN,1> input;\n    TQue<QuePosition::VECOUT,1> output;\n    TBuf<TPosition::VECCALC> scratch;\n    TBuf<TPosition::VECCALC> onesBuffer;\n    GlobalTensor<T> xGm, yGm;\n    uint32_t count, tile;\n};\nextern \"C\" __global__ __aicore__ void sigmoid_custom(GM_ADDR x, GM_ADDR y, GM_ADDR workspace, GM_ADDR tiling) {\n    REGISTER_TILING_DEFAULT(SigmoidCustomTilingData);\n    GET_TILING_DATA(t, tiling);\n    SigmoidKernel<DTYPE_X> kernel;\n    kernel.Init(x, y, t); kernel.Process();\n}\n'''\n\npython_bind_src = r'''\n#include <torch/extension.h>\n#include \"pytorch_npu_helper.hpp\"\nat::Tensor sigmoid(const at::Tensor& x) {\n    auto y = at::empty_like(x); EXEC_NPU_CMD(aclnnSigmoidCustom, x, y); return y;\n}\nPYBIND11_MODULE(TORCH_EXTENSION_NAME, m) { m.def(\"sigmoid\", &sigmoid); }\n'''\n\nmodel_src = '''\nimport torch\nimport custom_ops_lib\nclass ModelNew(torch.nn.Module):\n    def forward(self, x): return custom_ops_lib.sigmoid(x)\n'''\n",
+    "reference/cases.yaml": "# ----------------------------------------------------------------------------\n# Copyright (c) 2026 Huawei Technologies Co., Ltd.\n# This program is free software, you can redistribute it and/or modify it under the terms and conditions of\n# CANN Open Software License Agreement Version 2.0 (the \"License\").\n# Please refer to the License for details. You may not use this file except in compliance with the License.\n# THIS SOFTWARE IS PROVIDED ON AN \"AS IS\" BASIS, WITHOUT WARRANTIES OF ANY KIND, EITHER EXPRESS OR IMPLIED,\n# INCLUDING BUT NOT LIMITED TO NON-INFRINGEMENT, MERCHANTABILITY, OR FITNESS FOR A PARTICULAR PURPOSE.\n# See LICENSE in the root of the software repository for the full text of the License.\n# ----------------------------------------------------------------------------\n\ncases:\n- operator: Sigmoid\n  case_id: 1\n  input_shape:\n  - [1024, 1024]\n  dtype: [float16]\n  attrs: {}\n  value_range: [-1, 1]\n  note: \"S-float16-1M-对齐-对称小值域 | baseline_kernels: Sigmoid×1\"\n- operator: Sigmoid\n  case_id: 2\n  input_shape:\n  - [2048, 2048]\n  dtype: [float32]\n  attrs: {}\n  value_range: [-2, 2]\n  note: \"M-float32-4M-对齐-对称小值域 | baseline_kernels: Sigmoid×1\"\n- operator: Sigmoid\n  case_id: 3\n  input_shape:\n  - [4096, 4096]\n  dtype: [bfloat16]\n  attrs: {}\n  value_range: [-3, 3]\n  note: \"M-bfloat16-16M-对齐-对称小值域 | baseline_kernels: Sigmoid×1\"\n- operator: Sigmoid\n  case_id: 4\n  input_shape:\n  - [8192, 8192]\n  dtype: [float16]\n  attrs: {}\n  value_range: [-10, 10]\n  note: \"L-float16-67M-对齐-对称中值域-2D扁平 | baseline_kernels: Sigmoid×1\"\n- operator: Sigmoid\n  case_id: 5\n  input_shape:\n  - [8192, 8192]\n  dtype: [float32]\n  attrs: {}\n  value_range: [-100, 100]\n  note: \"L-float32-268M-对齐-对称大值域-2D | baseline_kernels: Sigmoid×1\"\n- operator: Sigmoid\n  case_id: 6\n  input_shape:\n  - [1023, 1023]\n  dtype: [bfloat16]\n  attrs: {}\n  value_range: [-0.1, 0.1]\n  note: \"S-bfloat16-1M-非对齐-对称微小值域 | baseline_kernels: Sigmoid×1\"\n- operator: Sigmoid\n  case_id: 7\n  input_shape:\n  - [1009, 1021]\n  dtype: [float16]\n  attrs: {}\n  value_range: [-1, 2]\n  note: \"S-float16-1M-质数非对齐-非对称小值域-5D | baseline_kernels: Sigmoid×1\"\n- operator: Sigmoid\n  case_id: 8\n  input_shape:\n  - [1537, 769]\n  dtype: [float32]\n  attrs: {}\n  value_range: [-5, 10]\n  note: \"S-float32-1M-非对齐-非对称中值域 | baseline_kernels: Sigmoid×1\"\n- operator: Sigmoid\n  case_id: 9\n  input_shape:\n  - [363, 367, 373]\n  dtype: [bfloat16]\n  attrs: {}\n  value_range: [-50, 100]\n  note: \"M-bfloat16-50M-质数非对齐-非对称大值域-3D | baseline_kernels: Sigmoid×1\"\n- operator: Sigmoid\n  case_id: 10\n  input_shape:\n  - [2049, 513]\n  dtype: [float16]\n  attrs: {}\n  value_range: [-65504, 65504]\n  note: \"S-float16-1M-非对齐-float16边界值 | baseline_kernels: Sigmoid×1\"\n- operator: Sigmoid\n  case_id: 11\n  input_shape:\n  - [3, 7, 13, 4001]\n  dtype: [float32]\n  attrs: {}\n  value_range: [-88, 88]\n  note: \"S-float32-1M-质数非对齐-float32边界值-4D | baseline_kernels: Sigmoid×1\"\n- operator: Sigmoid\n  case_id: 12\n  input_shape:\n  - [1000003]\n  dtype: [bfloat16]\n  attrs: {}\n  value_range: [-.inf, .inf]\n  note: \"S-bfloat16-1M-质数非对齐-inf特殊值-1D | baseline_kernels: Sigmoid×1\"\n- operator: Sigmoid\n  case_id: 13\n  input_shape:\n  - [11, 13, 17, 67, 67]\n  dtype: [float32]\n  attrs: {}\n  value_range: [.nan, .nan]\n  note: \"M-float32-10M-质数非对齐-nan特殊值-5D | baseline_kernels: Sigmoid×1\"\n- operator: Sigmoid\n  case_id: 14\n  input_shape:\n  - [3, 7, 11, 13, 1009]\n  dtype: [float16]\n  attrs: {}\n  value_range: [0, 0]\n  note: \"S-float16-3M-质数非对齐-零值-5D | baseline_kernels: Sigmoid×1\"\n- operator: Sigmoid\n  case_id: 15\n  input_shape:\n  - [512, 2049]\n  dtype: [float32]\n  attrs: {}\n  value_range: [-0.5, 0.5]\n  note: \"S-float32-1M-非对齐-对称微小值域 | baseline_kernels: Sigmoid×1\"\n- operator: Sigmoid\n  case_id: 16\n  input_shape:\n  - [255, 8193]\n  dtype: [bfloat16]\n  attrs: {}\n  value_range: [-1, 3]\n  note: \"S-bfloat16-2M-非对齐