{
  "name": "@kernelcat/pi-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "npm run check:types && node --test ../../../validation/*.mjs ../../../validation/tui/compatibility.mjs ../../../validation/tui/interaction.mjs ../../../validation/tui/agents-panel.mjs ../../../validation/tui/subagent-presentation.mjs ../../../validation/tui/session-discovery.mjs ../../../validation/tui/model-delta-isolation.mjs ../../../validation/tui/input-settlement.mjs ../../../validation/tui/pi-lattice-trace.mjs ../../../validation/tui/trace-projection.mjs",
    "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ../../packages/pi-lattice-trace/tsconfig.json && node scripts/check-managed-continuation.ts",
    "test:integration": "python3 -B ../../../validation/tui/run.py",
    "smoke:subagents": "node scripts/smoke-subagents.ts",
    "start": "node src/main.ts",
    "version-test-plan": "node scripts/version-test-plan.ts",
    "start:harness": "node src/harness/pi/worker.mjs",
    "replay:session": "node scripts/session-replay.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "ajv": "8.17.1",
    "pi-subagents": "0.87.0",
    "typebox": "1.3.27",
    "pi-workspace-history": "0.5.2"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@earendil-works/pi-telemetry": "1.5.0"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "exports": {
    ".": {
      "types": "./src/sdk/index.ts",
      "import": "./src/sdk/index.ts"
    },
    "./goal": {
      "types": "./src/sdk/goal.ts",
      "import": "./src/sdk/goal.ts"
    }
  },
  "types": "./src/sdk/index.ts"
}
