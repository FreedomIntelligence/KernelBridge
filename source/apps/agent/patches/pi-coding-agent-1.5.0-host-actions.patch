+/** KernelBridge: a marker before the first visible line of a message; continuation lines indent by two (Claude Code layout).
+    Trimming drops the component's own blank padding so one blank line separates rows, as in Claude Code. */
+function withGutter(component, enabled, marker, trim = false) {
+    if (!enabled)
+        return component;
+    const render = component.render.bind(component);
+    const visible = (line) => line.replace(/\x1b\[[0-9;?]*[ -\/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)/g, "").trim().length > 0;
+    component.render = (width) => {
+        let lines = render(Math.max(1, width - 2));
+        if (trim) {
+            while (lines.length && !visible(lines[0])) lines = lines.slice(1);
+            while (lines.length && !visible(lines[lines.length - 1])) lines = lines.slice(0, -1);
+        }
+        const first = lines.findIndex(visible);
+        return lines.map((line, index) => line.replace(/^((?:\x1b\][^\x07]*\x07)*)((?:\x1b\[[0-9;]*m)*)( ?)/, (_, osc, style, pad) => osc + pad + (index === first ? marker() + " " : "  ") + style));
+    };
+    return component;
+}
