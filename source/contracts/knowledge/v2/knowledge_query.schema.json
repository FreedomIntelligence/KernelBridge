{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelcat.local/contracts/knowledge/v2/knowledge_query.schema.json",
  "title": "KernelCat query identity and result V2",
  "$defs": {
    "QueryDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71
    },
    "QueryIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "BoundQueryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "corpus_authority_id",
        "config_digest",
        "schema_digest",
        "retained_view_digest"
      ],
      "properties": {
        "status": {
          "const": "bound"
        },
        "corpus_authority_id": {
          "$ref": "#/$defs/QueryDigest"
        },
        "config_digest": {
          "$ref": "#/$defs/QueryDigest"
        },
        "schema_digest": {
          "$ref": "#/$defs/QueryDigest"
        },
        "retained_view_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/QueryDigest"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "LegacyCaptureQueryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "corpus_authority_id",
        "config_digest",
        "schema_digest",
        "retained_view_digest"
      ],
      "properties": {
        "status": {
          "const": "legacy_capture_unknown"
        },
        "corpus_authority_id": {
          "$ref": "#/$defs/QueryDigest"
        },
        "config_digest": {
          "type": "null"
        },
        "schema_digest": {
          "$ref": "#/$defs/QueryDigest"
        },
        "retained_view_digest": {
          "$ref": "#/$defs/QueryDigest"
        }
      }
    },
    "InjectedRepositoryQueryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "corpus_authority_id",
        "config_digest",
        "schema_digest",
        "retained_view_digest"
      ],
      "properties": {
        "status": {
          "const": "injected_repository_unknown"
        },
        "corpus_authority_id": {
          "type": "null"
        },
        "config_digest": {
          "type": "null"
        },
        "schema_digest": {
          "$ref": "#/$defs/QueryDigest"
        },
        "retained_view_digest": {
          "type": "null"
        }
      }
    },
    "QueryBinding": {
      "oneOf": [
        {
          "$ref": "#/$defs/BoundQueryBinding"
        },
        {
          "$ref": "#/$defs/LegacyCaptureQueryBinding"
        },
        {
          "$ref": "#/$defs/InjectedRepositoryQueryBinding"
        }
      ]
    },
    "ReturnedQueryCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_id",
        "revision_id",
        "rank"
      ],
      "properties": {
        "card_id": {
          "$ref": "#/$defs/QueryIdentifier"
        },
        "revision_id": {
          "$ref": "#/$defs/QueryIdentifier"
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "QueryReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "binding",
        "query_digest",
        "active_index_revision",
        "returned",
        "adopted_card_ids",
        "wiki_mode",
        "latency_ms",
        "projection_digest"
      ],
      "properties": {
        "schema_version": {
          "const": "kernelcat.query-receipt/v2"
        },
        "binding": {
          "$ref": "#/$defs/QueryBinding"
        },
        "query_digest": {
          "$ref": "#/$defs/QueryDigest"
        },
        "active_index_revision": {
          "$ref": "#/$defs/QueryDigest"
        },
        "returned": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReturnedQueryCard"
          },
          "maxItems": 10
        },
        "adopted_card_ids": {
          "type": "null"
        },
        "wiki_mode": {
          "enum": [
            "local",
            "remote",
            "degraded"
          ]
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "projection_digest": {
          "$ref": "#/$defs/QueryDigest"
        }
      }
    },
    "LegacyOwnerObject": {
      "description": "Opaque V1 payload. Structural envelope validation does not replace its existing owner validator.",
      "type": "object",
      "additionalProperties": {}
    },
    "KnowledgeSearchResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "projection",
        "receipt",
        "token_count"
      ],
      "properties": {
        "schema_version": {
          "const": "kernelcat.knowledge-search-result/v2"
        },
        "projection": {
          "$ref": "#/$defs/LegacyOwnerObject"
        },
        "receipt": {
          "$ref": "#/$defs/QueryReceipt"
        },
        "token_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1200
        }
      }
    },
    "EvidenceBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "bundle_id",
        "producer",
        "created_at",
        "source_records",
        "evidence_refs",
        "query_receipts",
        "attempt_events",
        "artifact_refs"
      ],
      "properties": {
        "schema_version": {
          "const": "kernelcat.evidence-bundle/v2"
        },
        "bundle_id": {
          "type": "string",
          "pattern": "^eb_[A-Za-z0-9_-]+$",
          "minLength": 4,
          "maxLength": 512
        },
        "producer": {
          "$ref": "#/$defs/QueryIdentifier"
        },
        "created_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LegacyOwnerObject"
          },
          "maxItems": 10000
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LegacyOwnerObject"
          },
          "maxItems": 10000
        },
        "query_receipts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QueryReceipt"
          },
          "maxItems": 1000
        },
        "attempt_events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LegacyOwnerObject"
          },
          "maxItems": 10000
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LegacyOwnerObject"
          },
          "maxItems": 10000
        },
        "digest": {
          "$ref": "#/$defs/QueryDigest"
        }
      }
    }
  }
}
