{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelcat.local/contracts/knowledge/v1/knowledge_runtime.schema.json",
  "$ref": "#/$defs/KnowledgeCaptureRequest",
  "$comment": "Authoritative finite Knowledge-owner boundary. Wire canonical JSON uses sorted fixed ASCII keys, compact UTF-8, no lone surrogates, only safe integer numbers, and SHA-256. Original Knowledge payload blobs use their existing owner canonical rules. No field grants effect permission.",
  "$defs": {
    "KnowledgeIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "KnowledgeDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "KnowledgeControlRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "KnowledgeDependency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "card_revision",
            "source",
            "evidence"
          ]
        },
        "object_id": {
          "$ref": "#/$defs/KnowledgeIdentifier"
        },
        "revision_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^rev:sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "content_digest": {
          "$ref": "#/$defs/KnowledgeDigest"
        }
      },
      "required": [
        "kind",
        "object_id",
        "revision_id",
        "content_digest"
      ],
      "$comment": "Card revisions require their original revision_id; source/evidence require null. Full canonical payload digest supplements, never replaces, the original identity. Dependency arrays use unique (kind, object_id, revision_id) keys, ordered by UTF-8 bytes of kind, ID, revision-or-empty, digest.",
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "card_revision"
              }
            }
          },
          "then": {
            "properties": {
              "revision_id": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "revision_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "KnowledgeConsumer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "consumer_id": {
          "$ref": "#/$defs/KnowledgeIdentifier"
        },
        "journal_authority_digest": {
          "$ref": "#/$defs/KnowledgeDigest"
        },
        "account_id": {
          "$ref": "#/$defs/KnowledgeIdentifier"
        },
        "run_id": {
          "$ref": "#/$defs/KnowledgeIdentifier"
        },
        "trial_id": {
          "$ref": "#/$defs/KnowledgeIdentifier"
        },
        "required_journal_header": {
          "enum": [
            "runtime_account_initialized/v2",
            "runtime_account_initialized/v3"
          ]
        }
      },
      "required": [
        "consumer_id",
        "journal_authority_digest",
        "account_id",
        "run_id",
        "trial_id",
        "required_journal_header"
      ],
      "$comment": "Trusted composition identity, not model arguments or a bearer capability. One consumer is permanently bound to one Run/Trial and canonical Journal authority."
    },
    "KnowledgeRegistration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "kernelcat.knowledge-registration/v1"
        },
        "authority_id": {
          "$ref": "#/$defs/KnowledgeDigest"
        },
        "capture_intent_id": {
          "$ref": "#/$defs/KnowledgeIdentifier"
        },
        "capture_request_digest": {
          "$ref": "#/$defs/KnowledgeDigest"
        },
        "registration_epoch": {
          "const": 1
        },
        "consumer": {
          "$ref": "#/$defs/KnowledgeConsumer"
        }
      },
      "required": [
        "schema_version",
        "authority_id",
        "capture_intent_id",
        "capture_request_digest",
        "registration_epoch",
        "consumer"
      ],
      "$comment": "Immutable registration exists before a complete capture. An unknown pending selection is conservatively included in retraction barriers. Invalidation is terminal; no replacement or restoration within this registration."
    },
    "KnowledgeViewReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "kernelcat.knowledge-view-reference/v1"
        },
        "authority_id": {
          "$ref": "#/$defs/KnowledgeDigest"
        },
        "view_digest": {
          "$ref": "#/$defs/KnowledgeDigest"
        },
        "dependency_digest": {
          "$ref": "#/$defs/KnowledgeDigest"
        },
        "selection_rule": {
          "const": "active-v1-closure/v1"
        },
        "card_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "member_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "artifact_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        }
      },
      "required": [
        "schema_version",
        "authority_id",
        "view_digest",
        "dependency_digest",
        "selection_rule",
        "card_count",
        "member_count",
        "artifact_count",
        "total_bytes"
      ],
      "$comment": "Identity of a retained exact-member manifest, not a publication sequence. Hashes exact selected record/artifact digests and rule. Individual artifacts <=16 MiB. Source/evidence selectors and complete required source bytes remain verified by the original owner."
    },
    "KnowledgeCaptureRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "kernelcat.knowledge-capture-request/v1"
        },
        "intent_id": {
          "$ref": "#/$defs/KnowledgeIdentifier"
        },
        "consumer": {
          "$ref": "#/$defs/KnowledgeConsumer"
        },
        "expected_control_revision": {
          "$ref": "#/$defs/KnowledgeControlRevision"
        }
      },
      "required": [
        "schema_version",
        "intent_id",
        "consumer",
        "expected_control_revision"
      ]
    },
    "KnowledgeCaptureReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "kernelcat.knowledge-capture-receipt/v1"
        },
        "registration": {
          "$ref": "#/$defs/KnowledgeRegistration"
        },
        "view": {
          "$ref": "#/$defs/KnowledgeViewReference"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KnowledgeDependency"
          },
          "maxItems": 16384,
          "uniqueItems": true
        },
        "control_revision": {
          "$ref": "#/$defs/KnowledgeControlRevision"
        }
      },
      "required": [
        "schema_version",
        "registration",
        "view",
        "dependencies",
        "control_revision"
      ],
      "$comment": "Immutable original receipt, not current effect permission. Registration/view authorities must match. Dependency keys are unique and sorted, and dependency_digest must match the canonical array; member_count/card_count must match its kinds. Later current retraction is checked separately."
    },
    "KnowledgeControlStatus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "kernelcat.knowledge-control-status/v1"
        },
        "authority_id": {
          "$ref": "#/$defs/KnowledgeDigest"
        },
        "control_revision": {
          "$ref": "#/$defs/KnowledgeControlRevision"
        }
      },
      "required": [
        "schema_version",
        "authority_id",
        "control_revision"
      ]
    },
    "KnowledgeRetractionRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "kernelcat.knowledge-retraction-request/v1"
        },
        "intent_id": {
          "$ref": "#/$defs/KnowledgeIdentifier"
        },
        "expected_control_revision": {
          "$ref": "#/$defs/KnowledgeControlRevision"
        },
        "target": {
          "$ref": "#/$defs/KnowledgeDependency"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "schema_version",
        "intent_id",
        "expected_control_revision",
        "target",
        "reason"
      ],
      "$comment": "Trusted administrative request. A new intent CASes current deny revision. Exact intent/body replay precedes fresh CAS; changed body under the same ID conflicts. Target is an exact known member, never a wildcard."
    },
    "KnowledgeRetraction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "kernelcat.knowledge-retraction/v1"
        },
        "authority_id": {
          "$ref": "#/$defs/KnowledgeDigest"
        },
        "request": {
          "$ref": "#/$defs/KnowledgeRetractionRequest"
        },
        "request_digest": {
          "$ref": "#/$defs/KnowledgeDigest"
        },
        "control_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schema_version",
        "authority_id",
        "request",
        "request_digest",
        "control_revision"
      ],
      "$comment": "Immutable deny intent. control_revision orders Knowledge retraction admission only, not Journal events or publication history. New matching registrations are denied immediately; effective status additionally needs all original consumer ACKs."
    },
    "KnowledgeRetractionStatus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "kernelcat.knowledge-retraction-status/v1"
        },
        "retraction": {
          "$ref": "#/$defs/KnowledgeRetraction"
        },
        "status": {
          "enum": [
            "pending",
            "effective"
          ]
        },
        "required_consumers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fenced_consumers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schema_version",
        "retraction",
        "status",
        "required_consumers",
        "fenced_consumers"
      ],
      "$comment": "Current barrier status. fenced <= required; effective iff equal. Required membership is fixed at intent admission, includes unknown pending captures, and cannot shrink on TTL or unavailability."
    },
    "KnowledgeFenceRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "kernelcat.knowledge-fence-request/v1"
        },
        "fence_id": {
          "$ref": "#/$defs/KnowledgeDigest"
        },
        "registration": {
          "$ref": "#/$defs/KnowledgeRegistration"
        },
        "retraction": {
          "$ref": "#/$defs/KnowledgeRetraction"
        }
      },
      "required": [
        "schema_version",
        "fence_id",
        "registration",
        "retraction"
      ],
      "$comment": "fence_id hashes canonical {registration,retraction}. Authorities must agree. The original Journal must permanently fence this registration even before local install/freeze. Independent requests commute as terminal invalidation additions, not numeric max adoption."
    },
    "KnowledgeFenceReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "kernelcat.knowledge-fence-receipt/v1"
        },
        "fence_id": {
          "$ref": "#/$defs/KnowledgeDigest"
        },
        "request_digest": {
          "$ref": "#/$defs/KnowledgeDigest"
        },
        "registration": {
          "$ref": "#/$defs/KnowledgeRegistration"
        },
        "journal_seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "journal_event_digest": {
          "$ref": "#/$defs/KnowledgeDigest"
        }
      },
      "required": [
        "schema_version",
        "fence_id",
        "request_digest",
        "registration",
        "journal_seq",
        "journal_event_digest"
      ],
      "$comment": "Trusted original-Journal durable ACK. request_digest hashes the entire exact fence request; registration includes the required format/account/authority. A fixture or posted object is not proof of a live fence. Exact duplicate returns this historical receipt and cannot reactivate the registration."
    },
    "KnowledgeFencePage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "kernelcat.knowledge-fence-page/v1"
        },
        "retraction": {
          "$ref": "#/$defs/KnowledgeRetraction"
        },
        "requests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KnowledgeFenceRequest"
          },
          "maxItems": 100
        },
        "next_cursor": {
          "oneOf": [
            {
              "$ref": "#/$defs/KnowledgeIdentifier"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "retraction",
        "requests",
        "next_cursor"
      ],
      "$comment": "Requests are pending members from the fixed barrier set, ordered by consumer ID UTF-8 bytes after a keyset cursor. ACKs may remove pending rows; no offset pagination or current consumer scan changes required membership."
    },
    "KnowledgeConsumerStatus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "kernelcat.knowledge-consumer-status/v1"
        },
        "registration": {
          "$ref": "#/$defs/KnowledgeRegistration"
        },
        "control_revision": {
          "$ref": "#/$defs/KnowledgeControlRevision"
        },
        "invalidated": {
          "type": "boolean"
        },
        "pending_fence_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schema_version",
        "registration",
        "control_revision",
        "invalidated",
        "pending_fence_count"
      ],
      "$comment": "Read-only metadata observation for one already admitted exact capture request, sealed or unsealed. Unknown capture is an explicit error, never invalidated=false. Full original request body including expected_control_revision is matched before returning its original registration. pending_fence_count counts only this immutable consumer pending trusted ACKs; zero neither restores an invalidated registration nor proves another consumer/global barrier effective. No payload reads or effect grant."
    }
  }
}
