{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelcat.local/contracts/execution/v1/rpc_payload.schema.json",
  "title": "Ephemeral paged JSON payload transport within bounded v3 RPC frames",
  "$ref": "#/$defs/PayloadReference",
  "$defs": {
    "PayloadRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "bytes",
        "sha256"
      ],
      "additionalProperties": false
    },
    "PayloadReference": {
      "type": "object",
      "properties": {
        "transport": {
          "const": "kernelcat.rpc-payload/v1"
        },
        "ref": {
          "$ref": "#/$defs/PayloadRef"
        }
      },
      "required": [
        "transport",
        "ref"
      ],
      "additionalProperties": false
    },
    "PayloadReadRequest": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/PayloadRef"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        }
      },
      "required": [
        "ref",
        "offset",
        "max_bytes"
      ],
      "additionalProperties": false
    },
    "PayloadReadResult": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/PayloadRef"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "data": {
          "type": "string",
          "minLength": 1,
          "maxLength": 11184812,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        },
        "final": {
          "type": "boolean"
        }
      },
      "required": [
        "ref",
        "offset",
        "data",
        "final"
      ],
      "additionalProperties": false
    },
    "PayloadBeginRequest": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16781312
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "method": {
          "$ref": "#/$defs/PayloadMethod",
          "description": "Bind a new upload to this method. Omission is the original model-only upload."
        }
      },
      "required": [
        "bytes",
        "sha256"
      ],
      "additionalProperties": false,
      "$comment": "Overall upload bound. Owner/client additionally enforce method bounds: model 8 MiB + 4096; runtime prepare/freeze/snapshot/adopt/stop 16 MiB + 4096; existing native methods 4198400. Omitted method is model only. Uploads remain consume-before-parse and method-bound. RSI record/adapter/apply uploads are bounded to 2 MiB."
    },
    "PayloadWriteRequest": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/PayloadRef"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16781312
        },
        "data": {
          "type": "string",
          "minLength": 1,
          "maxLength": 11184812,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      },
      "required": [
        "ref",
        "offset",
        "data"
      ],
      "additionalProperties": false
    },
    "PayloadWriteResult": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/PayloadRef"
        },
        "next_offset": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16781312
        }
      },
      "required": [
        "ref",
        "next_offset"
      ],
      "additionalProperties": false
    },
    "PayloadCallRequest": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/PayloadRef"
        },
        "method": {
          "$ref": "#/$defs/PayloadMethod"
        }
      },
      "required": [
        "ref",
        "method"
      ],
      "additionalProperties": false
    },
    "PayloadMethod": {
      "enum": [
        "model",
        "native_begin",
        "native_call",
        "native_settle",
        "prepare_run",
        "freeze_run",
        "snapshot_program",
        "adopt_candidate",
        "stop_run",
        "knowledge_fence",
        "prepare_trial",
        "freeze_trial",
        "knowledge_sync",
        "rsi_record",
        "rsi_adapter",
        "rsi_apply"
      ]
    }
  }
}
