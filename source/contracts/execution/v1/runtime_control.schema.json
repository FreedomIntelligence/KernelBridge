{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelcat.local/contracts/execution/v1/runtime_control.schema.json",
  "$ref": "#/$defs/ExecutionStamp",
  "$defs": {
    "ExecutionStamp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "$ref": "https://kernelcat.local/contracts/lab/v1/task_contract.schema.json#/$defs/Identifier"
        },
        "run_id": {
          "$ref": "https://kernelcat.local/contracts/lab/v1/task_contract.schema.json#/$defs/Identifier"
        },
        "trial_id": {
          "$ref": "https://kernelcat.local/contracts/lab/v1/task_contract.schema.json#/$defs/Identifier"
        },
        "session": {
          "$ref": "https://kernelcat.local/contracts/lab/v1/objects.schema.json#/$defs/SessionReference"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "lease_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "control_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "branch_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "context_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "trial_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "run_status": {
          "enum": [
            "active",
            "generation_stopped",
            "reconciling",
            "stopped"
          ]
        },
        "trial_execution_state": {
          "$ref": "https://kernelcat.local/contracts/lab/v1/objects.schema.json#/$defs/TrialState"
        },
        "session_state": {
          "$ref": "https://kernelcat.local/contracts/lab/v1/objects.schema.json#/$defs/SessionState"
        },
        "run_credit_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "run_credit_spent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "run_credit_reserved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "trial_credit_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "trial_credit_spent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "trial_credit_reserved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "account_id",
        "run_id",
        "trial_id",
        "session",
        "generation",
        "lease_epoch",
        "control_revision",
        "branch_revision",
        "context_revision",
        "trial_revision",
        "run_status",
        "trial_execution_state",
        "session_state",
        "run_credit_limit",
        "run_credit_spent",
        "run_credit_reserved",
        "trial_credit_limit",
        "trial_credit_spent",
        "trial_credit_reserved"
      ],
      "$comment": "Read-only owner projection and CAS expectation, not a bearer capability. The Worker connection injects its execution identity; model arguments cannot choose it. Credit observations are logical ledger credits, not measured tokens or device time."
    },
    "CreditBudget": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "spent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reserved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "limit",
        "spent",
        "reserved"
      ],
      "additionalProperties": false
    }
  }
}
