{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelcat.local/contracts/execution/v1/targets.schema.json",
  "title": "Execution planning identities and finite compatibility proposals",
  "$ref": "#/$defs/ExecutionPlan",
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:/-]*(?![\\s\\S])"
    },
    "Text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\ud800-\\udfff]*(?![\\s\\S])"
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "Qualification": {
      "enum": [
        "supported",
        "unsupported",
        "unknown"
      ]
    },
    "TargetSpec": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "vendor": {
          "$ref": "#/$defs/Identifier"
        },
        "architectures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "uniqueItems": true,
          "maxItems": 128,
          "minItems": 1
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "program_form": {
          "$ref": "#/$defs/Identifier"
        },
        "protocol_id": {
          "$ref": "#/$defs/Identifier"
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requirements": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Text"
          },
          "maxProperties": 128
        }
      },
      "required": [
        "id",
        "vendor",
        "architectures",
        "required_capabilities",
        "program_form",
        "protocol_id",
        "memory_bytes",
        "requirements"
      ],
      "additionalProperties": false
    },
    "ToolchainSpec": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "build_target": {
          "$ref": "#/$defs/Identifier"
        },
        "flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Text"
          },
          "maxItems": 128
        }
      },
      "required": [
        "id",
        "digest",
        "build_target",
        "flags"
      ],
      "additionalProperties": false
    },
    "EnvironmentObservation": {
      "type": "object",
      "properties": {
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "driver": {
          "$ref": "#/$defs/Text"
        },
        "runtime": {
          "$ref": "#/$defs/Text"
        },
        "interference_domain": {
          "$ref": "#/$defs/Identifier"
        },
        "partition": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "digest",
        "driver",
        "runtime",
        "interference_domain",
        "partition"
      ],
      "additionalProperties": false
    },
    "DeviceRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "host_id": {
          "$ref": "#/$defs/Identifier"
        },
        "vendor": {
          "$ref": "#/$defs/Identifier"
        },
        "architecture": {
          "$ref": "#/$defs/Identifier"
        },
        "profile_digest": {
          "$ref": "#/$defs/Digest"
        },
        "health": {
          "enum": [
            "healthy",
            "unhealthy",
            "unknown"
          ]
        },
        "availability": {
          "enum": [
            "available",
            "busy",
            "unknown"
          ]
        },
        "available_memory_bytes": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "const": "unknown"
            }
          ]
        },
        "environment": {
          "$ref": "#/$defs/EnvironmentObservation"
        }
      },
      "required": [
        "id",
        "host_id",
        "vendor",
        "architecture",
        "profile_digest",
        "health",
        "availability",
        "available_memory_bytes",
        "environment"
      ],
      "additionalProperties": false
    },
    "AdapterQualification": {
      "type": "object",
      "properties": {
        "compiler_id": {
          "$ref": "#/$defs/Identifier"
        },
        "compiler_version": {
          "$ref": "#/$defs/Text"
        },
        "runtime_id": {
          "$ref": "#/$defs/Identifier"
        },
        "runtime_version": {
          "$ref": "#/$defs/Text"
        },
        "protocol_id": {
          "$ref": "#/$defs/Identifier"
        },
        "protocol_version": {
          "$ref": "#/$defs/Text"
        },
        "vendor": {
          "$ref": "#/$defs/Identifier"
        },
        "architectures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "uniqueItems": true,
          "maxItems": 128,
          "minItems": 1
        },
        "program_forms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "uniqueItems": true,
          "maxItems": 128,
          "minItems": 1
        },
        "capabilities": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Qualification"
          },
          "maxProperties": 128
        },
        "qualification": {
          "$ref": "#/$defs/Qualification"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Text"
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "toolchain": {
          "$ref": "#/$defs/ToolchainSpec"
        },
        "requirements": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Text"
          },
          "maxProperties": 128
        },
        "environment_digests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Digest"
          },
          "uniqueItems": true,
          "maxItems": 128
        }
      },
      "required": [
        "compiler_id",
        "compiler_version",
        "runtime_id",
        "runtime_version",
        "protocol_id",
        "protocol_version",
        "vendor",
        "architectures",
        "program_forms",
        "capabilities",
        "qualification",
        "evidence_refs",
        "toolchain",
        "requirements",
        "environment_digests"
      ],
      "additionalProperties": false
    },
    "ExecutionPlan": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "kernelcat.execution-plan/v1"
        },
        "task_contract_digest": {
          "$ref": "#/$defs/Digest"
        },
        "program_digest": {
          "$ref": "#/$defs/Digest"
        },
        "target": {
          "$ref": "#/$defs/TargetSpec"
        },
        "device": {
          "$ref": "#/$defs/DeviceRef"
        },
        "adapter": {
          "$ref": "#/$defs/AdapterQualification"
        },
        "inventory_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schema_version",
        "task_contract_digest",
        "program_digest",
        "target",
        "device",
        "adapter",
        "inventory_revision"
      ],
      "additionalProperties": false
    },
    "CompatibilityDecision": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/Qualification"
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Text"
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Text"
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "policy_version": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "status",
        "reasons",
        "evidence_refs",
        "policy_version"
      ],
      "additionalProperties": false
    },
    "Revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
