{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelcat.local/contracts/execution/v1/python_modules.schema.json",
  "title": "Expected Python modules and actual origin observations",
  "$ref": "#/$defs/ExpectedPythonModules",
  "$defs": {
    "ModuleName": {
      "type": "string",
      "enum": [
        "kernelcat_worker",
        "kernelcat_executor",
        "kernelcat_knowledge",
        "kernelcat_ingestion"
      ]
    },
    "DistributionName": {
      "type": "string",
      "enum": [
        "kernelcat-worker",
        "kernelcat-executor",
        "kernelcat-knowledge",
        "kernelcat-ingestion"
      ]
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "minLength": 71,
      "maxLength": 71
    },
    "FileUri": {
      "type": "string",
      "pattern": "^file:///(?:[A-Za-z0-9._~!$&'()+,;=:@/-]|%[0-9A-F]{2})+(?![\\s\\S])",
      "minLength": 9,
      "maxLength": 4096
    },
    "PythonSourceHashRule": {
      "const": "python-source-tree/v1"
    },
    "ExpectedPythonModule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "module_name": {
          "$ref": "#/$defs/ModuleName"
        },
        "distribution_name": {
          "$ref": "#/$defs/DistributionName"
        },
        "hash_rule": {
          "$ref": "#/$defs/PythonSourceHashRule"
        },
        "content_digest": {
          "$ref": "#/$defs/Digest"
        },
        "allowed_package_roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileUri"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        }
      },
      "required": [
        "module_name",
        "distribution_name",
        "hash_rule",
        "content_digest",
        "allowed_package_roots"
      ]
    },
    "ExpectedPythonModules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "kernelcat.python-module-binding/v1"
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExpectedPythonModule"
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "modules"
      ]
    },
    "KnownPythonModuleOrigin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "known"
        },
        "module_origin": {
          "$ref": "#/$defs/FileUri"
        },
        "package_root": {
          "$ref": "#/$defs/FileUri"
        },
        "hash_rule": {
          "$ref": "#/$defs/PythonSourceHashRule"
        },
        "content_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "state",
        "module_origin",
        "package_root",
        "hash_rule",
        "content_digest"
      ]
    },
    "UnknownPythonModuleOrigin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "unknown"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\uD800-\\uDFFF]*$"
        }
      },
      "required": [
        "state",
        "reason"
      ]
    },
    "PythonModuleOrigin": {
      "oneOf": [
        {
          "$ref": "#/$defs/KnownPythonModuleOrigin"
        },
        {
          "$ref": "#/$defs/UnknownPythonModuleOrigin"
        }
      ]
    },
    "PythonModuleObservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "module_name": {
          "$ref": "#/$defs/ModuleName"
        },
        "origin": {
          "$ref": "#/$defs/PythonModuleOrigin"
        }
      },
      "required": [
        "module_name",
        "origin"
      ]
    },
    "PythonModuleReport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "kernelcat.python-module-report/v1"
        },
        "expected_binding_digest": {
          "$ref": "#/$defs/Digest"
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PythonModuleObservation"
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "expected_binding_digest",
        "observations"
      ]
    }
  }
}
