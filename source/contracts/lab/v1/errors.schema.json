{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelcat.local/contracts/lab/v1/errors.schema.json",
  "title": "KernelCat lab error envelope v1",
  "$ref": "#/$defs/LabErrorEnvelope",
  "$comment": "The containing transport owns version, correlation, operation identity and adoption. This declaration does not authorize a retry or establish an external outcome.",
  "$defs": {
    "LabErrorCode": {
      "enum": [
        "invalid_request",
        "not_found",
        "revision_conflict",
        "unsupported",
        "not_dispatched",
        "unknown_outcome",
        "internal_error"
      ]
    },
    "LabError": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/LabErrorCode"
        },
        "message": {
          "$ref": "https://kernelcat.local/contracts/lab/v1/task_contract.schema.json#/$defs/Text"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "not_dispatched"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "retryable": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "retryable": {
                "const": false
              }
            }
          }
        }
      ],
      "$comment": "not_dispatched requires owner-confirmed absence of an admitted intent/effect. Unknown external outcomes retain the original handle and reservation for reconciliation. Conflicts require reread/new admission, not changed parameters under an old key."
    },
    "LabErrorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/LabError"
        }
      },
      "required": [
        "error"
      ]
    }
  }
}
