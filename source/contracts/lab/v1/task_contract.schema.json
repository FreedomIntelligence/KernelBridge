        "cyclomatic_complexity": {
          "$ref": "#/$defs/QualityInteger"
        },
        "max_function_lines": {
          "$ref": "#/$defs/QualityInteger"
        },
        "specialization_paths": {
          "$ref": "#/$defs/QualityInteger"
        },
        "template_instantiations": {
          "$ref": "#/$defs/QualityInteger"
        },
        "unreachable_blocks": {
          "$ref": "#/$defs/QualityInteger"
        },
        "duplicate_blocks": {
          "$ref": "#/$defs/QualityInteger"
        },
        "registers": {
          "$ref": "#/$defs/QualityInteger"
        },
