{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelcat.local/contracts/lab/v1/task_contract.schema.json",
  "title": "KernelAgent frozen operator task contract",
  "$ref": "#/$defs/TaskContract",
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:/-]*(?![\\s\\S])",
      "$comment": "Negative lookahead anchors at absolute input end in Python and ECMAScript."
    },
    "Text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\ud800-\\udfff]*(?![\\s\\S])"
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "DecimalInteger": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)(?![\\s\\S])"
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "synthetic_fixture",
            "frozen_inputs"
          ]
        },
        "source": {
          "$ref": "#/$defs/Text"
        },
        "source_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "kind",
        "source",
        "source_digest"
      ]
    },
    "OperatorSemantics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/Text"
        },
        "definition": {
          "$ref": "#/$defs/Text"
        },
        "reference_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "name",
        "definition",
        "reference_digest"
      ]
    },
    "Target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vendor": {
          "$ref": "#/$defs/Identifier"
        },
        "architecture": {
          "$ref": "#/$defs/Identifier"
        },
        "requirements": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Text"
          },
          "minProperties": 0
        }
      },
      "required": [
        "vendor",
        "architecture",
        "requirements"
      ]
    },
    "Strides": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "minItems": 0
    },
    "TensorDomain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "minItems": 0
        },
        "dtype": {
          "$ref": "#/$defs/Identifier"
        },
        "layout": {
          "$ref": "#/$defs/Identifier"
        },
        "strides": {
          "$ref": "#/$defs/Strides"
        }
      },
      "required": [
        "shape",
        "dtype",
        "layout"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "layout": {
                "const": "strided"
              }
            },
            "required": [
              "layout"
            ]
          },
          "then": {
            "required": [
              "strides"
            ],
            "properties": {
              "strides": {
                "$ref": "#/$defs/Strides"
              }
            }
          }
        }
      ]
    },
    "CaseDomain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/TensorDomain"
          },
          "minProperties": 0
        },
        "outputs": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/TensorDomain"
          },
          "minProperties": 1
        }
      },
      "required": [
        "weight",
        "inputs",
        "outputs"
      ]
    },
    "InputDomain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "casepack_digest": {
          "$ref": "#/$defs/Digest"
        },
        "cases": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/CaseDomain"
          },
          "minProperties": 1
        }
      },
      "required": [
        "casepack_digest",
        "cases"
      ]
    },
    "FloatingTolerance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "floating"
        },
        "atol": {
          "type": "number",
          "minimum": 0
        },
        "rtol": {
          "type": "number",
          "minimum": 0
        },
        "nan": {
          "enum": [
            "reject",
            "same_positions"
          ]
        },
        "inf": {
          "enum": [
            "reject",
            "same_sign_and_positions"
          ]
        },
        "comparison": {
          "enum": [
            "elementwise_abs_rel",
            "complex_magnitude"
          ]
        }
      },
      "required": [
        "kind",
        "atol",
        "rtol",
        "nan",
        "inf",
        "comparison"
      ]
    },
    "IntegerTolerance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "integer"
        },
        "exact": {
          "const": true
        },
        "sentinels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DecimalInteger"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "exact",
        "sentinels"
      ]
    },
    "BooleanTolerance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "boolean"
        },
        "exact": {
          "const": true
        }
      },
      "required": [
        "kind",
        "exact"
      ]
    },
    "Tolerance": {
      "oneOf": [
        {
          "$ref": "#/$defs/FloatingTolerance"
        },
        {
          "$ref": "#/$defs/IntegerTolerance"
        },
        {
          "$ref": "#/$defs/BooleanTolerance"
        }
      ]
    },
    "Specialization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "case_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Text"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "case_ids",
        "assumptions"
      ]
    },
    "SpecializationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Specialization"
          },
          "minItems": 0
        },
        "outside_domain": {
          "const": "reject"
        }
      },
      "required": [
        "allowed",
        "outside_domain"
      ]
    },
    "AliasingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output_aliases": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Identifier"
          },
          "minProperties": 0
        },
        "in_place": {
          "type": "boolean"
        }
      },
      "required": [
        "output_aliases",
        "in_place"
      ]
    },
    "Baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "program_id": {
          "$ref": "#/$defs/Identifier"
        },
        "artifact_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "program_id",
        "artifact_digest"
      ]
    },
    "OfficialScore": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "official"
        },
        "rule_id": {
          "$ref": "#/$defs/Identifier"
        },
        "direction": {
          "enum": [
            "maximize",
            "minimize"
          ]
        }
      },
      "required": [
        "kind",
        "rule_id",
        "direction"
      ]
    },
    "GeometricSpeedupScore": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "weighted_geomean_speedup"
        },
        "direction": {
          "const": "maximize"
        }
      },
      "required": [
        "kind",
        "direction"
      ]
    },
    "MeanLatencyScore": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "weighted_mean_latency"
        },
        "direction": {
          "const": "minimize"
        }
      },
      "required": [
        "kind",
        "direction"
      ]
    },
    "ScorePolicy": {
      "oneOf": [
        {
          "$ref": "#/$defs/OfficialScore"
        },
        {
          "$ref": "#/$defs/GeometricSpeedupScore"
        },
        {
          "$ref": "#/$defs/MeanLatencyScore"
        }
      ]
    },
    "UntimedLevel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timing": {
          "const": false
        },
        "correctness_case_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "timing",
        "correctness_case_ids"
      ]
    },
    "TimedLevel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timing": {
          "const": true
        },
        "correctness_case_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "warmup_iterations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "blocks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "samples_per_arm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "pairing": {
          "enum": [
            "parent_bracketed",
            "alternating"
          ]
        },
        "case_reducer": {
          "enum": [
            "mean",
            "median"
          ]
        },
        "minimum_effect": {
          "type": "number",
          "minimum": 0
        },
        "confidence_level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "bootstrap_resamples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "timing",
        "correctness_case_ids",
        "warmup_iterations",
        "blocks",
        "samples_per_arm",
        "pairing",
        "case_reducer",
        "minimum_effect",
        "confidence_level",
        "bootstrap_resamples"
      ]
    },
    "MeasurementLevel": {
      "oneOf": [
        {
          "$ref": "#/$defs/UntimedLevel"
        },
        {
          "$ref": "#/$defs/TimedLevel"
        }
      ]
    },
    "MeasurementLevels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "smoke": {
          "$ref": "#/$defs/MeasurementLevel"
        },
        "quick": {
          "$ref": "#/$defs/TimedLevel"
        },
        "full": {
          "$ref": "#/$defs/TimedLevel"
        }
      },
      "required": [
        "smoke",
        "quick",
        "full"
      ]
    },
    "MeasurementProtocol": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "$ref": "#/$defs/Identifier"
        },
        "levels": {
          "$ref": "#/$defs/MeasurementLevels"
        }
      },
      "required": [
        "rule_id",
        "levels"
      ]
    },
    "CachePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "hot",
            "evicted",
            "natural"
          ]
        },
        "rule_id": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "mode",
        "rule_id"
      ]
    },
    "Synchronization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "before_interval": {
          "$ref": "#/$defs/Text"
        },
        "completion": {
          "const": "all_streams_in_interval"
        }
      },
      "required": [
        "before_interval",
        "completion"
      ]
    },
    "TimingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "enum": [
            "kernel_only",
            "end_to_end"
          ]
        },
        "clock": {
          "enum": [
            "device_event",
            "host_monotonic"
          ]
        },
        "cache": {
          "$ref": "#/$defs/CachePolicy"
        },
        "synchronization": {
          "$ref": "#/$defs/Synchronization"
        },
        "input_preparation": {
          "const": "outside_interval"
        },
        "profiling": {
          "const": "excluded"
        }
      },
      "required": [
        "scope",
        "clock",
        "cache",
        "synchronization",
        "input_preparation",
        "profiling"
      ]
    },
    "Budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_build_seconds": {
          "type": "number",
          "minimum": 0
        },
        "max_evaluation_seconds": {
          "type": "number",
          "minimum": 0
        },
        "max_total_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_device_memory_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_scratch_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "max_build_seconds",
        "max_evaluation_seconds",
        "max_total_seconds",
        "max_device_memory_bytes",
        "max_scratch_bytes"
      ]
    },
    "QualityMetric": {
      "enum": [
        "compile_seconds",
        "binary_bytes",
        "cyclomatic_complexity",
        "max_function_lines",
        "specialization_paths",
        "template_instantiations",
        "unreachable_blocks",
        "duplicate_blocks",
        "registers",
        "spill_bytes",
        "new_warnings",
        "logical_loc_growth_ratio"
      ]
    },
    "QualityLimits": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/QualityMetric"
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      },
      "minProperties": 0
    },
    "QualityTieBreak": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relative_score_tolerance": {
          "type": "number",
          "minimum": 0
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QualityMetric"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "final": {
          "const": "program_id_ascending"
        }
      },
      "required": [
        "relative_score_tolerance",
        "metrics",
        "final"
      ]
    },
    "CleanupTriggers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logical_loc_growth_ratio": {
          "type": "number",
          "minimum": 0
        },
        "complexity_growth_ratio": {
          "type": "number",
          "minimum": 0
        },
        "fork_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "before_final_delivery": {
          "const": true
        }
      },
      "required": [
        "logical_loc_growth_ratio",
        "complexity_growth_ratio",
        "fork_count",
        "before_final_delivery"
      ]
    },
    "QualityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "$ref": "#/$defs/Identifier"
        },
        "hard_limits": {
          "$ref": "#/$defs/QualityLimits"
        },
        "forbidden_patterns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Text"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "tie_break": {
          "$ref": "#/$defs/QualityTieBreak"
        },
        "cleanup_triggers": {
          "$ref": "#/$defs/CleanupTriggers"
        }
      },
      "required": [
        "rule_id",
        "hard_limits",
        "forbidden_patterns",
        "tie_break",
        "cleanup_triggers"
      ]
    },
    "TaskContract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "kernelcat.task-contract/v1"
        },
        "contract_id": {
          "$ref": "#/$defs/Identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "purpose": {
          "enum": [
            "campaign",
            "research"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "operator": {
          "$ref": "#/$defs/OperatorSemantics"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "input_domain": {
          "$ref": "#/$defs/InputDomain"
        },
        "tolerances": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Tolerance"
          },
          "minProperties": 1
        },
        "specialization_policy": {
          "$ref": "#/$defs/SpecializationPolicy"
        },
        "aliasing": {
          "$ref": "#/$defs/AliasingPolicy"
        },
        "allowed_calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "baseline": {
          "$ref": "#/$defs/Baseline"
        },
        "scoring": {
          "$ref": "#/$defs/ScorePolicy"
        },
        "measurement_protocol": {
          "$ref": "#/$defs/MeasurementProtocol"
        },
        "timing": {
          "$ref": "#/$defs/TimingPolicy"
        },
        "budgets": {
          "$ref": "#/$defs/Budgets"
        },
        "quality_policy": {
          "$ref": "#/$defs/QualityPolicy"
        }
      },
      "required": [
        "schema_version",
        "contract_id",
        "revision",
        "purpose",
        "provenance",
        "operator",
        "target",
        "input_domain",
        "tolerances",
        "specialization_policy",
        "aliasing",
        "allowed_calls",
        "baseline",
        "scoring",
        "measurement_protocol",
        "timing",
        "budgets",
        "quality_policy"
      ]
    },
    "TaskContractSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_digest": {
          "$ref": "#/$defs/Digest"
        },
        "contract": {
          "$ref": "#/$defs/TaskContract"
        }
      },
      "required": [
        "source_digest",
        "contract"
      ]
    },
    "UnknownObservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "unknown"
        },
        "reason": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "status",
        "reason"
      ]
    },
    "DeviceProvenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "known"
        },
        "device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "pool_revision": {
          "$ref": "#/$defs/Identifier"
        },
        "vendor": {
          "$ref": "#/$defs/Identifier"
        },
        "architecture": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "status",
        "device_id",
        "pool_revision",
        "vendor",
        "architecture"
      ]
    },
    "DeviceObservation": {
      "oneOf": [
        {
          "$ref": "#/$defs/DeviceProvenance"
        },
        {
          "$ref": "#/$defs/UnknownObservation"
        }
      ]
    },
    "EnvironmentObservation": {
      "oneOf": [
        {
          "$ref": "#/$defs/Digest"
        },
        {
          "$ref": "#/$defs/UnknownObservation"
        }
      ]
    },
    "MeasuredCase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "measured"
        },
        "baseline_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "candidate_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "status",
        "baseline_ms",
        "candidate_ms"
      ]
    },
    "CaseMeasurement": {
      "oneOf": [
        {
          "$ref": "#/$defs/MeasuredCase"
        },
        {
          "$ref": "#/$defs/UnknownObservation"
        }
      ]
    },
    "CorrectnessVerdict": {
      "enum": [
        "passed",
        "failed",
        "unknown"
      ]
    },
    "QualityNumber": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/UnknownObservation"
        }
      ]
    },
    "QualityInteger": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "$ref": "#/$defs/UnknownObservation"
        }
      ]
    },
    "QualityDuration": {
