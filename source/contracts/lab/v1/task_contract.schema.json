      "required": [
        "evaluation_id",
        "receipt_revision",
        "receipt_digest",
        "stage",
        "program_id",
        "artifact_digest",
        "task_contract_digest",
        "casepack_digest",
        "baseline",
        "timing",
        "measurement_protocol",
        "environment",
        "device",
        "correctness",
        "measurements",
        "specialization_ids",
        "quality_metrics"
      ]
    },
    "ScoringResultSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "kernelcat.scoring-input/v1"
