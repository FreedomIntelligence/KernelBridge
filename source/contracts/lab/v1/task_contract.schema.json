          "minimum": 1,
          "maximum": 9007199254740991
        },
        "receipt_digest": {
          "$ref": "#/$defs/Digest"
        },
        "stage": {
          "enum": [
            "screen",
            "confirm",
            "final"
          ]
        },
        "program_id": {
          "$ref": "#/$defs/Identifier"
        },
        "artifact_digest": {
          "$ref": "#/$defs/Digest"
        },
        "task_contract_digest": {
          "$ref": "#/$defs/Digest"
        },
        "casepack_digest": {
          "$ref": "#/$defs/Digest"
        },
        "baseline": {
          "$ref": "#/$defs/Baseline"
        },
        "timing": {
          "$ref": "#/$defs/TimingPolicy"
        },
        "measurement_protocol": {
          "$ref": "#/$defs/MeasurementProtocol"
        },
        "environment": {
          "$ref": "#/$defs/EnvironmentObservation"
        },
        "device": {
          "$ref": "#/$defs/DeviceObservation"
        },
