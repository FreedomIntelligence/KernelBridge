{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelcat.dev/schemas/kernelcat-evidence.schema.json",
  "title": "KernelCat candidate source evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "bottleneck_ids",
    "expected_route",
    "capability_predicate"
  ],
  "properties": {
    "schema_version": {"const": "kernelcat.source-evidence/v1"},
    "policy_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "bottleneck_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "expected_route": {"type": "string", "minLength": 1, "maxLength": 256},
    "capability_predicate": {"type": "string", "minLength": 1, "maxLength": 1000},
    "notes": {"type": "string", "maxLength": 4000}
  }
}
