#!/bin/sh
set -eu
BUNDLE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
RUNTIME=${KERNELCAT_RUNTIME:-"$BUNDLE/runtime"}
NODE=${KERNELCAT_NODE:-node}
BOOTSTRAP=${KERNELCAT_BOOTSTRAP_PYTHON:-python3}
DEVELOPMENT=0
if [ -f "$BUNDLE/.installation/ready" ]; then
    IFS= read -r SELECTED_NODE < "$BUNDLE/.installation/node"
    IFS= read -r SELECTED_RUNTIME < "$BUNDLE/.installation/runtime"
    NODE=${KERNELCAT_NODE:-"$SELECTED_NODE"}
    RUNTIME=${KERNELCAT_RUNTIME:-"$SELECTED_RUNTIME"}
    BOOTSTRAP=${KERNELCAT_BOOTSTRAP_PYTHON:-"$RUNTIME/venv/bin/python"}
fi
if [ -f "$BUNDLE/.development/ready" ]; then
    DEVELOPMENT=1
    IFS= read -r SELECTED_NODE < "$BUNDLE/.development/node"
    IFS= read -r SELECTED_PYTHON < "$BUNDLE/.development/python"
    IFS= read -r SELECTED_EXPECTED < "$BUNDLE/.development/expected"
    IFS= read -r SELECTED_IMPORTS < "$BUNDLE/.development/pythonpath"
    NODE=${KERNELCAT_NODE:-"$SELECTED_NODE"}
    BOOTSTRAP=${KERNELCAT_BOOTSTRAP_PYTHON:-"$SELECTED_PYTHON"}
    export PYTHONPATH="$SELECTED_IMPORTS"
fi
"$BOOTSTRAP" -I -B "$BUNDLE/install.py" --verify-only >/dev/null
if [ "${1:-}" = session-replay ]; then
    shift
    exec "$NODE" "$BUNDLE/source/apps/agent/scripts/session-replay.ts" "$@"
fi
if [ "$#" -eq 0 ]; then
    set -- tui
fi
for argument in "$@"; do
    if [ "$argument" = --help ] || [ "$argument" = -h ]; then
        exec "$NODE" "$BUNDLE/source/apps/agent/src/main.ts" "$@"
    fi
done
if [ "$DEVELOPMENT" -eq 0 ]; then
    [ -f "$BUNDLE/.installation/ready" ] && [ -x "$RUNTIME/venv/bin/python" ] && [ -f "$RUNTIME/expected.json" ] || {
    echo "Run the explicit install.py step from README.md first." >&2
    exit 2
}
    SELECTED_PYTHON="$RUNTIME/venv/bin/python"
    SELECTED_EXPECTED="$RUNTIME/expected.json"
fi
if [ "${1:-}" = pursue ] || [ "${1:-}" = sessions ] || [ "${1:-}" = session ] || [ "${1:-}" = trace ]; then
    exec "$NODE" "$BUNDLE/source/apps/agent/src/main.ts" "$@"
fi
HAS_PYTHON=0
HAS_EXPECTED_MODULES=0
for argument in "$@"; do
    case "$argument" in
        --python) HAS_PYTHON=1 ;;
        --expected-python-modules) HAS_EXPECTED_MODULES=1 ;;
    esac
done
if [ "$HAS_PYTHON" -eq 0 ]; then
    set -- "$@" --python "$SELECTED_PYTHON"
fi
if [ "$HAS_EXPECTED_MODULES" -eq 0 ]; then
    set -- "$@" --expected-python-modules "$SELECTED_EXPECTED"
fi
exec "$NODE" "$BUNDLE/source/apps/agent/src/main.ts" "$@"
