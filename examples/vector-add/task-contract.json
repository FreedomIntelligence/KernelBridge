  "operator": {
    "name": "vector_add",
    "definition": "Equal-length finite Float32Array inputs a,b in [-1000,1000]; return a new Float32Array with sum[i] = Math.fround(a[i] + b[i]); preserve both inputs. Zero length and irregular tails are included. Standard Float32Array and Math operations only. No imports, files, network, process, timers or hardcoded outputs.",
    "reference_digest": "sha256:caa7d834c2a1262c9ae899348013d518140cfe652e23429db8137baf2d1d2f28"
  },
  "target": {
    "vendor": "host",
    "architecture": "cpu",
    "requirements": {
      "runtime": "Node >=22.19; synchronous JavaScript Float32Array on host CPU",
      "inputs": "Seed root 17; xorshift32 finite generator; per-sample seeds from SHA256(namespace:index), first uint32 LE or 1",
      "qualification": "Declared TaskContract only; actual RSI receipts retain independent measured evidence"
    }
  },
